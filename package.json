{
  "name": "dsh-pr-inbox",
  "version": "0.1.0",
  "description": "DSH 插件：侧边栏 PR 面板 —— 自动绑定当前工作区的项目，按「我提的 / 待我审 / 我合并的」三桶原生渲染 GitHub PR，复用本机 gh CLI，只读。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-pr-inbox.git"
  },
  "homepage": "https://github.com/omdsh-dev/dsh-pr-inbox#readme",
  "bugs": {
    "url": "https://github.com/omdsh-dev/dsh-pr-inbox/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gates": "node scripts/gates/run.mjs",
    "prepack": "pnpm build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-better-sidebar",
    "github",
    "pull-request",
    "review",
    "sidebar"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "dsh-better-sidebar": "^0.28.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}