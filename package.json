{
  "name": "dsh-pr-inbox",
  "version": "0.1.0",
  "description": "DSH 插件：侧边栏 PR 面板 —— 自动绑定当前工作区的项目，按「我提的 / 待我审 / 最近合并」三桶原生渲染 GitHub PR，复用本机 gh CLI，只读。",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-better-sidebar",
    "github",
    "pull-request",
    "review",
    "sidebar"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "dsh-better-sidebar": ">=0.26.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "dsh-better-sidebar": "^0.26.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}